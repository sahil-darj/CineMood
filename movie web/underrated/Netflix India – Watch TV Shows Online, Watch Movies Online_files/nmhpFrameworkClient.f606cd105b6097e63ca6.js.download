absolute;\n                    z-index:1000;\n                    top:0;\n                    left:0;\n\n                    display:inline-block;\n                    max-width: 500px;\n                    background: #1e1e1e;\n                    color: white;\n                    border-width: 0 1px 1px 0;\n                    border-color: red;\n                    border-style: solid;\n\n                    cursor:default;\n                }\n                .dev-info-console.show-console{\n                    border-radius: 0 0 20px 0;\n                }\n                @media only screen and (max-width: 500px) {\n                    .dev-info-console {\n                        font-size:12px;\n                    }\n\n                }\n\n                .dev-info-console-title-inline {\n                    float: left;\n                }\n\n                .dev-info-console-inline-setting {\n                    float: left;\n                    margin-left: 2em;\n                }\n\n                .dev-info-console button {\n                    cursor: pointer;\n                    margin: 5px;\n                    font-size: 15px;\n                    border:1px solid black;\n                    border-radius:3px;\n                    color: white;\n                    background: rgb(229, 9, 20);\n\n                    /* this transition nonsense is so that there\'s a white flash, which provides feedback that the button has done something */\n                    transition: .5s background;\n                }\n                .dev-info-console button:hover:not(:disabled){\n                    background: rgb(246, 18, 29);\n                }\n                .dev-info-console button:active:not(:disabled){\n                    background: white;\n                    transition: none;\n                }\n                .dev-info-console button:disabled{\n                    color: lightgray;\n                    cursor:default;\n                }\n\n                .dev-info-console .console-tip{\n                    font-style:italic;\n                    display:none;\n                }\n\n                .dev-info-console .console-contents{\n                    display:none;\n                    padding: 4px;\n                }\n                .dev-info-console.show-console .console-contents{\n                    display:block;\n                }\n                .dev-info-console.show-console .console-tip{\n                    display:inline;\n                }\n\n                @media only screen and (max-width: 500px) {\n                    .dev-info-console.show-console .console-tip{\n                        display: block;\n                        text-align: center;\n                    }\n                }\n\n                .dev-info-console.show-console a {\n                    padding-left: 3px;\n                }\n                .dev-info-console h4{\n                    font-size: 19px;\n                    font-weight: 500;\n                    margin: 0 5px;\n                    display: inline-block;\n                    user-select: none;\n                    cursor: pointer;\n                }\n\n                .dev-info-console .console-subsection {\n                    margin:0 3px 0 8px;\n                    padding:0;\n                }\n\n                .dev-info-console li {\n                    margin:0;\n                    list-style:none;\n                    clear: both;\n                }\n                .dev-info-console li:nth-of-type(even) {\n                    /* will stripe the console items to make them easier to read */\n                    background-color: #3c3c3c;\n                }\n\n                .dev-info-console .console-item-label,\n                .dev-info-console .console-item-value {\n                    display: inline-block;\n                }\n\n                .dev-info-console .console-item-label {\n                    padding-right:5px;\n                }\n\n                .dev-info-console .console-item-value {\n                    float: right;\n\n                    word-break: break-all;\n                }\n                .dev-info-console .console-item-value,\n                .dev-info-console .cookie-label,\n                .dev-info-console .ab-allocation-item {\n                    font-family:monospace;\n                    cursor: copy;\n\n                    /* These are items which may be copied by clicking on them */\n                }\n\n                .dev-info-console .console-item-value:hover,\n                .dev-info-console .cookie-label:hover,\n                .dev-info-console .ab-allocation-item:hover  {\n                    /* will highlight the value you\'re hovering over */\n                    background-color:#980000;\n                }\n\n                /* hiding elements which are used by VanillaJS only and not for display to the user ever */\n                .dev-info-console .console-appdata,\n                .dev-info-console .console-ab-allocation-data,\n                .dev-info-console .cookie-value {\n                    display:none;\n                }\n\n\n\n\n                /* Force AB allocation styles */\n                .console-force-ab.console-subsection{\n\n                }\n                .dev-info-console .id-type-section label {\n                    margin-left:4px;\n                }\n\n                .dev-info-console .ab-test-info-section {\n                    display:inline-block;\n                }\n\n\n                .dev-info-console .console-force-ab input[type="number"]::-webkit-outer-spin-button,\n                .dev-info-console .console-force-ab input[type="number"]::-webkit-inner-spin-button {\n                    -webkit-appearance: none;\n                    margin: 0;\n                }\n                .dev-info-console .console-force-ab input[type="number"] {\n                    -moz-appearance: textfield;\n                    font-s