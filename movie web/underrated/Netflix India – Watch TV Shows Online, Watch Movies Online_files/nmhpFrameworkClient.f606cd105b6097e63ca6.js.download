ssageBadging: true\n                }\n            ) {\n                taglineMessages {\n                    tagline\n                    typedClassification\n                    badgeDate\n                    badgePrefix\n                }\n                state\n            }\n        }\n    }\n":o.LiveEventTaglinesFragmentDoc,"\n    fragment VideoPlaylist on Video {\n        videoId\n\n        isPlayable\n        isAvailable\n        unplayableCauses\n\n        isInPlaylist\n        isInRemindMeList\n        playlistActions\n    }\n":o.VideoPlaylistFragmentDoc,"\n    fragment GamePlaylist on Game {\n        gameId\n\n        isPlayable\n        isInPlaylist\n        gamePlaylistActions: playlistActions\n    }\n":o.GamePlaylistFragmentDoc,"\n    mutation AddToPlaylist($entityId: ID!, $trackId: ID) {\n        addEntityToPlaylist(input: { entityId: $entityId, trackId: $trackId }) {\n            entity {\n                ... on Video {\n                    videoId\n                    isInPlaylist\n                    isInRemindMeList\n                }\n                ... on Game {\n                    gameId\n                    gamePlaylistActions: playlistActions\n                    isInPlaylist\n                }\n            }\n        }\n    }\n":o.AddToPlaylistDocument,"\n    mutation RemoveFromPlaylist($entityId: ID!, $trackId: ID) {\n        removeEntityFromPlaylist(\n            input: { entityId: $entityId, trackId: $trackId }\n        ) {\n            entity {\n                ... on Video {\n                    videoId\n                    isInPlaylist\n                    isInRemindMeList\n                }\n                ... on Game {\n                    gameId\n                    gamePlaylistActions: playlistActions\n                    isInPlaylist\n                }\n            }\n        }\n    }\n":o.RemoveFromPlaylistDocument,"\n    mutation AddVideoReminder(\n        $entityId: ID!\n        $signature: String\n        $trackId: ID\n    ) {\n        addToRemindMe(\n            input: {\n                videoId: $entityId\n                signature: $signature\n                trackId: $trackId\n            }\n        ) {\n            videoId\n            playlistActions\n            isInPlaylist\n            isInRemindMeList\n        }\n    }\n":o.AddVideoReminderDocument,"\n    mutation RemoveVideoReminder(\n        $entityId: ID!\n        $signature: String\n        $trackId: ID\n    ) {\n        removeFromRemindMe(\n            input: {\n                videoId: $entityId\n                signature: $signature\n                trackId: $trackId\n            }\n        ) {\n            videoId\n            playlistActions\n            isInPlaylist\n            isInRemindMeList\n        }\n    }\n":o.RemoveVideoReminderDocument,"#graphql\n    fragment ResumableVideoCurrentStandalone on Movie {\n        videoId\n        title\n        ...VideoBadging \n    }\n":o.ResumableVideoCurrentStandaloneFragmentDoc,'#graphql\n    fragment ResumableVideoCurrentEpisode on Episode {\n        videoId\n\n        title\n        number\n        hideEpisodeNumbers: hasTitleBehavior(\n            behavior: "hiddenEpisodeNumbers"\n        )\n        parentSeason {\n            videoId\n            number\n            title\n            numberLabel: numberLabelV2(label: ABBR)\n            hideEpisodeNumbers: hasTitleBehavior(\n                behavior: "hiddenEpisodeNumbers"\n            )\n        }\n\n        ...VideoBadging \n    }\n':o.ResumableVideoCurrentEpisodeFragmentDoc,"#graphql\n    fragment ResumableVideo on Video {\n        videoId\n\n        ...on Movie {\n            ...ResumableVideoCurrentStandalone\n        }\n\n        ... on Episode {\n            videoId\n            ...ResumableVideoCurrentEpisode\n        }\n\n        ... on Show {\n            currentEpisode {\n                videoId\n                ...ResumableVideoCurrentEpisode\n            }\n        }\n        ... on Season {\n            parentShow {\n                videoId\n                currentEpisode {\n                    ...ResumableVideoCurrentEpisode\n                }\n            }\n        }\n    }\n":o.ResumableVideoFragmentDoc,"\n    fragment TitleGroup on TitleGroup {\n        id\n        kind\n        title\n        siblings {\n            videoId\n        }\n    }\n":o.TitleGroupFragmentDoc,"\n    fragment VideoTitleGroups on Video {\n        ... on Movie {\n            titleGroupMemberships {\n                ...TitleGroup\n            }\n        }\n        ... on Show {\n            titleGroupMemberships {\n                ...TitleGroup\n            }\n        }\n        ... on Season {\n            parentShow {\n                titleGroupMemberships {\n                    ...TitleGroup\n                }\n            }\n        }\n        ... on Episode {\n            parentShow {\n                titleGroupMemberships {\n                    ...TitleGroup\n                }\n            }\n        }\n    }\n":o.VideoTitleGroupsFragmentDoc,"\n    fragment GameTitleGroups on Game {\n        titleGroupMemberships {\n            ...TitleGroup\n        }\n    }\n":o.GameTitleGroupsFragmentDoc,"#graphql\n    fragment VideoBadging on Video {\n        videoId\n        badges\n    }\n":o.VideoBadgingFragmentDoc,"#graphql\n    fragment WatchedVideoCurrent on Viewable {\n        ...on Video {\n            videoId\n            title\n            watchStatus\n        }\n\n        runtimeSec\n        ...Bookmark\n    }\n":o.WatchedVideoCurrentFragmentDoc,"#graphql\n    fragment WatchedVideo on Video {\n        videoId\n        watchStatus\n\n        ...on Episode {\n            ...WatchedVideoCurrent\n        }\n\n        ...on Show {\n            currentEpisode {\n                videoId\n                ...WatchedVideoCurrent\n            }\n        }\n\n        ...on Season {\n            parentShow {\n                videoId\n                currentEpisode {\n                    videoId\n                    ...WatchedVideoCurrent\n                }\n            }\n        }\n\n        ...on Movie {\n            ...WatchedVideoCurrent\n        }\n    }\n":o.WatchedVideoFragmentDoc,"\n    fragment Billboard960 on Video {\n        videoId\n        billboard960: artwork(\n            params: {\n                artworkType: BILLBOARD\n                dimension: { width: 960, matchStrategy: LARGER }\n                format: $opaqueImageFormat\n                features: { fallbackStrategy: STORY_ART }\n            }\n        ) {\n            ...Artwork\n        }\n    }\n":o.Billboard960FragmentDoc,"\n    fragment LogoCropped400 on Video {\n        videoId\n        logoCropped400: artwork(\n            params: {\n                artworkType: LOGO_HORIZONTAL_CROPPED\n                dimension: { width: 400 }\n                format: $transparentImageFormat\n            }\n        ) {\n            ...Artwork\n        }\n    }\n":o.LogoCropped400FragmentDoc,"\n    fragment Boxshot200NoTop10NoRecentlyAdded on Video {\n        videoId\n        boxshot200NoTop10NoRecentlyAdded: artwork(\n            params: {\n                artworkType: BOXSHOT\n                dimension: { width: 200 }\n                features: {\n                    suppressTop10Badge: true\n                    performNewContentCheck: false\n                }\n                format: $opaqueImageFormat\n            }\n        ) {\n            ...Artwork\n        }\n    }\n":o.Boxshot200NoTop10NoRecentlyAddedFragmentDoc,'\n    fragment TrendingTitleModalFragment on Video {\n        videoId\n        title\n        latestYear\n        shortSynopsis\n        isAvailable\n        contentAdvisory {\n            certificationValue\n        }\n        coreGenres {\n            edges {\n                node {\n                    genreId\n                    name\n                }\n            }\n        }\n        ...Billboard960\n        ...LogoCropped400\n        ...Boxshot200NoTop10NoRecentlyAdded\n\n        # The title of shows are things like "Season 1" and we need the actual\n        # show title for the alt text of the show logo.\n        ... on Season {\n            parentShow {\n                videoId\n                title\n            }\n        }\n    }\n':o.TrendingTitleModalFragmentFragmentDoc,"\n    fragment TrendingTitleFragment on Video {\n        ... on Season {\n            parentShow {\n                videoId\n            }\n        }\n        videoId\n        title\n        ...Boxshot200NoTop10NoRecentlyAdded\n    }\n":o.TrendingTitleFragmentFragmentDoc,"\n    query NmhpTrendingTitleSectionQuery(\n        $opaqueImageFormat: ArtworkFormat!\n        $transparentImageFormat: ArtworkFormat!\n    ) {\n        trending: growthVideoCollections(\n            collectionsInput: {\n                collectionInputs: [{ collectionType: TRENDING_NOW, limit: 10 }]\n            }\n        ) {\n            __typename\n            collections {\n                videos {\n                    __typename\n                    videoId\n                    ...TrendingTitleFragment\n                    ...TrendingTitleModalFragment\n                }\n            }\n        }\n    }\n":o.NmhpTrendingTitleSectionQueryDocument,"\n    mutation HideTitleViewing($input: HideTitleViewingInput!) {\n        hideTitleViewing(input: $input) {\n            result\n        }\n    }\n":o.HideTitleViewingDocument,"\n    mutation HideAllViewings($input: HideAllViewingsInput!) {\n        hideAllViewings(input: $input) {\n            result\n        }\n    }\n":o.HideAllViewingsDocument,"\n    query viewingHistoryCSV($options: ViewingHistoryCSVOptions!) {\n        viewingHistoryCSV(options: $options)\n    }\n":o.viewingHistoryCSVDocument,"\n    fragment PaymentHistoryTemplateAccount on Account {\n        canViewPaymentHistory\n        countryOfSignUp {\n            code\n        }\n        currentPlan {\n            plan {\n                displayName\n                planId\n                price {\n                    priceFormatted\n                }\n            }\n            features {\n                type # EXTRA_MEMBER\n                featureOptions {\n                    price {\n                        priceFormatted\n                    }\n                    type # EXTRA_MEMBER_WITHOUT_ADS, EXTRA_MEMBER_WITH_ADS\n                }\n            }\n            totalPrice {\n                priceFormatted\n            }\n        }\n        nextPlan {\n            plan {\n                displayName\n                planId\n                price {\n                    priceFormatted\n                }\n            }\n            features {\n                type # EXTRA_MEMBER\n                featureOptions {\n                    price {\n                        priceFormatted\n                    }\n                    type # EXTRA_MEMBER_WITHOUT_ADS, EXTRA_MEMBER_WITH_ADS\n                }\n            }\n            totalPrice {\n                priceFormatted\n            }\n            totalCurrentMemberUouOfferPrice {\n                priceFormatted\n            }\n        }\n        membershipStatus\n        growthInvoiceHistory(contextInput: {}) {\n            edges {\n                node {\n                    invoiceId\n                    invoiceDescription\n                    invoiceCreationDate {\n                        formattedDate(\n                            formattedDateInput: {\n                                formatType: SHORT\n                                localeOverride: $locale\n                            }\n                        )\n                    }\n                    paymentMethod {\n                        displayText\n                        paymentOptionLogo {\n                            paymentOptionLogo\n                        }\n                        ... on GrowthBundlePaymentMethod {\n                            partnerName\n                        }\n                    }\